{% set ns_prefix = '/' + namespace + '/' if namespace else '/' %}
- ros_topic_name: "{{ ns_prefix }}sbg_ig500n/imu"
  gz_topic_name: "{{ ns_prefix }}sbg_ig500n/imu"
  ros_type_name: "sensor_msgs/msg/Imu"
  gz_type_name: "gz.msgs.IMU"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}{{ sensors['imu_sbg_ig500n']['frame_id'] }}"

- ros_topic_name: "{{ ns_prefix }}sick_lms_291/scan"
  gz_topic_name: "{{ ns_prefix }}sick_lms_291/scan"
  ros_type_name: "sensor_msgs/msg/LaserScan"
  gz_type_name: "gz.msgs.LaserScan"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}{{ sensors['lidar_2d_sick_lms_291']['frame_id'] }}"

- ros_topic_name: "{{ ns_prefix }}sbg_ig500n/navsat"
  gz_topic_name: "{{ ns_prefix }}sbg_ig500n/navsat"
  ros_type_name: "sensor_msgs/msg/NavSatFix"
  gz_type_name: "gz.msgs.NavSat"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}{{ sensors['gps_sbg_ig500n']['frame_id'] }}"

- ros_topic_name: "{{ ns_prefix }}ground_truth/odometry"
  gz_topic_name: "{{ ns_prefix }}ground_truth/odometry"
  ros_type_name: "nav_msgs/msg/Odometry"
  gz_type_name: "gz.msgs.Odometry"
  direction: "GZ_TO_ROS"

- ros_topic_name: "{{ ns_prefix }}sbg_ig500n/navsat/base/fix"
  gz_topic_name: "{{ ns_prefix }}sbg_ig500n/navsat/base/fix"
  ros_type_name: "sensor_msgs/msg/NavSatFix"
  gz_type_name: "gz.msgs.NavSat"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}cg_link"

- ros_topic_name: "{{ ns_prefix }}sbg_ig500n/navsat/front_axle/fix"
  gz_topic_name: "{{ ns_prefix }}sbg_ig500n/navsat/front_axle/fix"
  ros_type_name: "sensor_msgs/msg/NavSatFix"
  gz_type_name: "gz.msgs.NavSat"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}front_axle_center_link"

- ros_topic_name: "{{ ns_prefix }}sbg_ig500n/navsat/rear_axle/fix"
  gz_topic_name: "{{ ns_prefix }}sbg_ig500n/navsat/rear_axle/fix"
  ros_type_name: "sensor_msgs/msg/NavSatFix"
  gz_type_name: "gz.msgs.NavSat"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}rear_axle_center_link"

- ros_topic_name: "{{ ns_prefix }}rs_helios_5515/points"
  gz_topic_name: "{{ ns_prefix }}rs_helios_5515/points"
  ros_type_name: "sensor_msgs/msg/PointCloud2"
  gz_type_name: "gz.msgs.PointCloudPacked"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}{{ sensors['lidar_3d_rs_helios_5515']['frame_id'] }}"

{#- ZED 2i cameras: one set of bridges per enabled camera_rgbd sensor. -#}
{% for name, cfg in sensors.items() if cfg.type == 'camera_rgbd' and cfg.get('enabled', true) %}
- ros_topic_name: "{{ ns_prefix }}{{ name }}/zed_node/left/color/rect/image"
  gz_topic_name: "{{ ns_prefix }}{{ name }}/rgbd/image"
  ros_type_name: "sensor_msgs/msg/Image"
  gz_type_name: "gz.msgs.Image"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}{{ cfg.frame_id }}_optical"

- ros_topic_name: "{{ ns_prefix }}{{ name }}/zed_node/left/color/rect/camera_info"
  gz_topic_name: "{{ ns_prefix }}{{ name }}/rgbd/camera_info"
  ros_type_name: "sensor_msgs/msg/CameraInfo"
  gz_type_name: "gz.msgs.CameraInfo"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}{{ cfg.frame_id }}_optical"

- ros_topic_name: "{{ ns_prefix }}{{ name }}/zed_node/depth/depth_registered"
  gz_topic_name: "{{ ns_prefix }}{{ name }}/rgbd/depth_image"
  ros_type_name: "sensor_msgs/msg/Image"
  gz_type_name: "gz.msgs.Image"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}{{ cfg.frame_id }}_optical"

- ros_topic_name: "{{ ns_prefix }}{{ name }}/zed_node/point_cloud/cloud_registered"
  gz_topic_name: "{{ ns_prefix }}{{ name }}/rgbd/points"
  ros_type_name: "sensor_msgs/msg/PointCloud2"
  gz_type_name: "gz.msgs.PointCloudPacked"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}{{ cfg.frame_id }}_optical"
{% endfor %}

{% if 'imu_vn100' in sensors and sensors['imu_vn100'].get('enabled', True) %}
- ros_topic_name: "{{ ns_prefix }}vectornav/imu"
  gz_topic_name: "{{ ns_prefix }}vectornav/imu"
  ros_type_name: "sensor_msgs/msg/Imu"
  gz_type_name: "gz.msgs.IMU"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}{{ sensors['imu_vn100']['frame_id'] }}"

- ros_topic_name: "{{ ns_prefix }}vectornav/magnetic"
  gz_topic_name: "{{ ns_prefix }}vectornav/magnetic"
  ros_type_name: "sensor_msgs/msg/MagneticField"
  gz_type_name: "gz.msgs.Magnetometer"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}{{ sensors['imu_vn100']['frame_id'] }}"

- ros_topic_name: "{{ ns_prefix }}vectornav/pressure"
  gz_topic_name: "{{ ns_prefix }}vectornav/pressure"
  ros_type_name: "sensor_msgs/msg/FluidPressure"
  gz_type_name: "gz.msgs.FluidPressure"
  direction: "GZ_TO_ROS"
  frame_id: "{{ prefix }}{{ sensors['imu_vn100']['frame_id'] }}"
{% endif %}
