<?xml version="1.0" ?>
<sdf version="1.11">
{#- ============================================================ #}
{#- Derived geometry                                             #}
{#- ============================================================ #}
{%- set PI = 3.1415926535897931 %}
{%- set inertial_origin_offset_z   = 0.3 - wheel_radius %}
{%- set vehicle_collision_offset_z = vehicle_collision_height / 2 - wheel_radius %}
{%- set rect_Ixx  = (1/12) * mass * (track_width**2 + height**2) %}
{%- set rect_Iyy  = (1/12) * mass * (wheelbase**2  + height**2) %}
{%- set rect_Izz  = (1/12) * mass * (wheelbase**2  + track_width**2) %}
{%- set wheel_Ixx = (1/12) * wheel_mass * (3*wheel_radius**2 + wheel_width**2) %}
{%- set wheel_Iyy = wheel_Ixx %}
{%- set wheel_Izz = (1/2)  * wheel_mass * wheel_radius**2 %}

{#- Color constants (RGBA) #}
{%- set color_black = "0.0 0.0 0.0 1.0" %}
{%- set color_white = "1.0 1.0 1.0 1.0" %}
{%- set color_red   = "0.8 0.0 0.0 1.0" %}
{%- set color_blue  = "0.0 0.0 0.8 1.0" %}

{#- IMU offsets from base_link (m) #}
{%- set imu_offset_x = 0.7 %}
{%- set imu_offset_y = 0.0 %}
{%- set imu_offset_z = 0.4 %}
{%- set imu_covariance_gyro  = 0.0 %}
{%- set imu_covariance_accel = 0.0 %}
{%- set imu_update_rate      = 100 %}

{#- GPS offsets from base_link (m) #}
{%- set gps_offset_x    = -wheelbase / 2 %}
{%- set gps_offset_y    = 0.0 %}
{%- set gps_offset_z    = 0.5 %}
{%- set gps_update_rate = 10 %}

{#- ============================================================ #}
{#- MACRO: material_color                                        #}
{#- ============================================================ #}
{%- macro material_color(rgba) %}
          <material>
            <ambient>{{ rgba }}</ambient>
            <diffuse>{{ rgba }}</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <emissive>0 0 0 1</emissive>
          </material>
{%- endmacro %}

{#- ============================================================ #}
{#- MACRO: rear_wheel — velocity control                         #}
{#- ============================================================ #}
{%- macro rear_wheel(name, y_offset) %}

      <link name="{{ prefix }}{{ name }}">
        <pose relative_to="{{ prefix }}base_link">{{ -wheelbase/2 }} {{ y_offset }} 0 0 0 {{ PI/2 }}</pose>
        <collision name="{{ prefix }}{{ name }}_collision">
          <pose>0 0 0 {{ PI/2 }} 0 {{ PI/2 }}</pose>
          <geometry>
            <cylinder>
              <length>{{ wheel_width }}</length>
              <radius>{{ wheel_radius }}</radius>
            </cylinder>
          </geometry>
        </collision>
        <visual name="{{ prefix }}{{ name }}_visual">
          <pose>0 0 0 {{ PI/2 }} 0 {{ PI/2 }}</pose>
          <geometry>
            <cylinder>
              <length>{{ wheel_width }}</length>
              <radius>{{ wheel_radius }}</radius>
            </cylinder>
          </geometry>
          {{ material_color(color_black) }}
        </visual>
        <inertial>
          <pose>0 0 0 {{ PI/2 }} 0 {{ PI/2 }}</pose>
          <mass>{{ wheel_mass }}</mass>
          <inertia>
            <ixx>{{ wheel_Ixx }}</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>{{ wheel_Iyy }}</iyy><iyz>0</iyz><izz>{{ wheel_Izz }}</izz>
          </inertia>
        </inertial>
      </link>

      <joint name="{{ prefix }}{{ name }}_joint" type="revolute">
        <parent>{{ prefix }}base_link</parent>
        <child>{{ prefix }}{{ name }}</child>
        <pose relative_to="{{ prefix }}{{ name }}"/>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e308</lower><upper>1e308</upper></limit>
          <dynamics damping="0.01" friction="0.01"/>
        </axis>
        <gz_ros2_control>
          <command_interface name="velocity">
            <param name="min">-10</param>
            <param name="max">10</param>
          </command_interface>
          <state_interface name="velocity"/>
          <state_interface name="position"/>
        </gz_ros2_control>
      </joint>
{%- endmacro %}

{#- ============================================================ #}
{#- MACRO: front_wheel_assembly — position control + passive     #}
{#- ============================================================ #}
{%- macro front_wheel_assembly(name, y_offset) %}

      <link name="{{ prefix }}{{ name }}_steer_link">
        <pose relative_to="{{ prefix }}base_link">{{ wheelbase/2 }} {{ y_offset }} 0 0 0 0</pose>
      </link>

      <joint name="{{ prefix }}{{ name }}_steer_joint" type="revolute">
        <parent>{{ prefix }}base_link</parent>
        <child>{{ prefix }}{{ name }}_steer_link</child>
        <pose relative_to="{{ prefix }}{{ name }}_steer_link"/>
        <axis>
          <xyz expressed_in="__model__">0 0 1</xyz>
          <limit>
            <lower>{{ -max_steer_angle }}</lower>
            <upper>{{ max_steer_angle }}</upper>
            <effort>1e6</effort>
            <velocity>100</velocity>
          </limit>
          <dynamics damping="1.0" friction="0.1"/>
        </axis>
        <gz_ros2_control>
          <command_interface name="position">
            <param name="min">{{ -max_steer_angle }}</param>
            <param name="max">{{ max_steer_angle }}</param>
          </command_interface>
          <state_interface name="position"/>
        </gz_ros2_control>
      </joint>

      <link name="{{ prefix }}{{ name }}">
        <pose relative_to="{{ prefix }}{{ name }}_steer_link">0 0 0 {{ -PI/2 }} 0 0</pose>
        <collision name="{{ prefix }}{{ name }}_collision">
          <geometry>
            <cylinder>
              <length>{{ wheel_width }}</length>
              <radius>{{ wheel_radius }}</radius>
            </cylinder>
          </geometry>
        </collision>
        <visual name="{{ prefix }}{{ name }}_visual">
          <geometry>
            <cylinder>
              <length>{{ wheel_width }}</length>
              <radius>{{ wheel_radius }}</radius>
            </cylinder>
          </geometry>
          {{ material_color(color_black) }}
        </visual>
        <inertial>
          <mass>{{ wheel_mass }}</mass>
          <inertia>
            <ixx>{{ wheel_Ixx }}</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>{{ wheel_Iyy }}</iyy><iyz>0</iyz><izz>{{ wheel_Izz }}</izz>
          </inertia>
        </inertial>
      </link>

      <joint name="{{ prefix }}{{ name }}_joint" type="revolute">
        <parent>{{ prefix }}{{ name }}_steer_link</parent>
        <child>{{ prefix }}{{ name }}</child>
        <pose relative_to="{{ prefix }}{{ name }}"/>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1e308</lower><upper>1e308</upper></limit>
        </axis>
        <gz_ros2_control>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </gz_ros2_control>
      </joint>
{%- endmacro %}


  <model name="{{ prefix }}caddy_ai2" canonical_link="{{ prefix }}base_footprint">

    <plugin filename="libignition-gazebo-pose-publisher-system"
            name="ignition::gazebo::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <update_frequency>100</update_frequency>
    </plugin>

    <!-- ==================== BASE ==================== -->
    <link name="{{ prefix }}base_footprint">
      <pose relative_to="__model__">0 0 0 0 0 0</pose>
      <visual name="{{ prefix }}base_footprint_visual">
        <geometry>
          <box>
            <size>{{ vehicle_collision_length }} {{ vehicle_collision_width }} 0.01</size>
          </box>
        </geometry>
        {{ material_color(color_red) }}
      </visual>
    </link>

    <joint name="{{ prefix }}base_joint" type="fixed">
      <parent>{{ prefix }}base_footprint</parent>
      <child>{{ prefix }}base_link</child>
    </joint>

    <link name="{{ prefix }}base_link">
      <pose relative_to="{{ prefix }}base_footprint">0 0 {{ wheel_radius }} 0 0 0</pose>
      <inertial>
        <mass>{{ mass }}</mass>
        <pose>{{ inertial_origin_offset_x }} 0 {{ inertial_origin_offset_z }} 0 0 0</pose>
        <inertia>
          <ixx>{{ rect_Ixx }}</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>{{ rect_Iyy }}</iyy><iyz>0</iyz><izz>{{ rect_Izz }}</izz>
        </inertia>
      </inertial>
      <visual name="{{ prefix }}base_link_visual">
        <geometry>
          <mesh>
            <uri>package://caddy_ai2_ros2_description/meshes/stl/rbcar_chassis.stl</uri>
          </mesh>
        </geometry>
        {{ material_color(color_white) }}
      </visual>
      <collision name="{{ prefix }}base_link_collision">
        <pose>{{ vehicle_collision_offset_x }} 0 {{ vehicle_collision_offset_z }} 0 0 0</pose>
        <geometry>
          <box>
            <size>{{ vehicle_collision_length }} {{ vehicle_collision_width }} {{ vehicle_collision_height }}</size>
          </box>
        </geometry>
      </collision>
      <sensor name="{{ prefix }}navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>{{ gps_update_rate }}</update_rate>
        <pose>{{ gps_offset_x }} {{ gps_offset_y }} {{ gps_offset_z }} 0 0 0</pose>
        <topic>{% if namespace %}/{{ namespace }}/navsat{% else %}/navsat{% endif %}</topic>
      </sensor>
    </link>

    <!-- ==================== WHEELS ==================== -->
    {{ rear_wheel("rear_right_wheel", -(track_width/2)) }}
    {{ rear_wheel("rear_left_wheel",    track_width/2) }}
    {{ front_wheel_assembly("front_right_wheel", -(track_width/2)) }}
    {{ front_wheel_assembly("front_left_wheel",   track_width/2) }}

    <!-- ==================== gz_ros2_control ==================== -->
    <ros2_control name="{{ prefix }}caddy_ai2_hardware" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>

      <joint name="{{ prefix }}rear_right_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="velocity"/>
        <state_interface name="position"/>
      </joint>
      <joint name="{{ prefix }}rear_left_wheel_joint">
        <command_interface name="velocity">
          <param name="min">-10</param>
          <param name="max">10</param>
        </command_interface>
        <state_interface name="velocity"/>
        <state_interface name="position"/>
      </joint>

      <joint name="{{ prefix }}front_right_wheel_steer_joint">
        <command_interface name="position">
          <param name="min">{{ -max_steer_angle }}</param>
          <param name="max">{{ max_steer_angle }}</param>
        </command_interface>
        <state_interface name="position"/>
      </joint>
      <joint name="{{ prefix }}front_left_wheel_steer_joint">
        <command_interface name="position">
          <param name="min">{{ -max_steer_angle }}</param>
          <param name="max">{{ max_steer_angle }}</param>
        </command_interface>
        <state_interface name="position"/>
      </joint>

      <joint name="{{ prefix }}front_right_wheel_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="{{ prefix }}front_left_wheel_joint">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <ros>
        {% if namespace %}<namespace>/{{ namespace }}</namespace>{% endif %}
        <remapping>bicycle_steering_controller/tf_odometry:=/tf</remapping>
      </ros>
      <parameters>{{ controllers_yaml_path }}</parameters>
    </plugin>

    <!-- ==================== IMU ==================== -->
    <link name="{{ prefix }}imu_link">
      <pose relative_to="{{ prefix }}base_link">{{ imu_offset_x }} {{ imu_offset_y }} {{ imu_offset_z }} 0 0 0</pose>
      <visual name="{{ prefix }}imu_visual">
        <geometry><box><size>0.05 0.05 0.02</size></box></geometry>
        {{ material_color(color_black) }}
      </visual>
      <sensor name="{{ prefix }}imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>{{ imu_update_rate }}</update_rate>
        <visualize>true</visualize>
        <topic>{% if namespace %}/{{ namespace }}/imu{% else %}/imu{% endif %}</topic>
        <gz_frame_id>{{ prefix }}imu_link</gz_frame_id>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>{{ imu_covariance_gyro }}</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>{{ imu_covariance_gyro }}</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>{{ imu_covariance_gyro }}</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0.0</mean><stddev>{{ imu_covariance_accel }}</stddev></noise></x>
            <y><noise type="gaussian"><mean>0.0</mean><stddev>{{ imu_covariance_accel }}</stddev></noise></y>
            <z><noise type="gaussian"><mean>0.0</mean><stddev>{{ imu_covariance_accel }}</stddev></noise></z>
          </linear_acceleration>
        </imu>
      </sensor>
    </link>
    <joint name="{{ prefix }}imu_joint" type="fixed">
      <parent>{{ prefix }}base_link</parent>
      <child>{{ prefix }}imu_link</child>
    </joint>

    <!-- ==================== SICK LMS 291 (injected fragment) ==================== -->
    {{ sick_lidar_fragment }}

  </model>
</sdf>
