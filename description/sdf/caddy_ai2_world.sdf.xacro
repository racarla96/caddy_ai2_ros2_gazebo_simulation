<?xml version="1.0" ?>
<sdf version="1.11" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- SDF Specification 1.11 -->
  <!-- https://sdformat.org/spec/1.11/sdf/ -->

  <!-- ============================================ -->
  <!-- 1. Definir argumentos globales               -->
  <!-- ============================================ -->
  <xacro:arg name="robot1_prefix" default="robot1_"/>
  <xacro:arg name="robot1_x" default="0"/>
  <xacro:arg name="robot1_y" default="0"/>
  <xacro:arg name="robot1_yaw" default="0"/>
  
  <xacro:arg name="robot2_prefix" default="robot2_"/>
  <xacro:arg name="robot2_x" default="3"/>
  <xacro:arg name="robot2_y" default="0"/>
  <xacro:arg name="robot2_yaw" default="0"/>
  
  <xacro:arg name="robot3_prefix" default="robot3_"/>
  <xacro:arg name="robot3_x" default="-3"/>
  <xacro:arg name="robot3_y" default="2"/>
  <xacro:arg name="robot3_yaw" default="1.57"/>

  <!-- ============================================ -->
  <!-- 2. Incluir dependencias                      -->
  <!-- ============================================ -->
  <xacro:include filename="$(find caddy_ai2_ros2_gazebo_simulation)/description/sdf/materials.sdf.xacro"/>
  <xacro:include filename="$(find caddy_ai2_ros2_gazebo_simulation)/description/sdf/caddy_ai2_model.sdf.xacro"/>

  <!-- ============================================ -->
  <!-- 3. Definir el mundo                          -->
  <!-- ============================================ -->
  <world name='base_world'>
    
    <!-- Física y plugins (igual que antes) -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Luz solar -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- Configuración global -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>3.17226 -5.10401 6.58845 0 0.739643 2.19219</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ============================================ -->
    <!-- 4. Instanciar múltiples robots               -->
    <!-- ============================================ -->
    
    <!-- Robot 1 -->
    <xacro:caddy_ai2_robot 
      prefix="" 
      x="0" 
      y="0" 
      yaw="0"/>
    <!--<xacro:caddy_ai2_robot 
      prefix="$(arg robot1_prefix)" 
      x="$(arg robot1_x)" 
      y="$(arg robot1_y)" 
      yaw="$(arg robot1_yaw)"/>-->
    
    <!-- Robot 2 -->
    <!--<xacro:caddy_ai2_robot 
      prefix="$(arg robot2_prefix)" 
      x="$(arg robot2_x)" 
      y="$(arg robot2_y)" 
      yaw="$(arg robot2_yaw)"/>-->
    
    <!-- Robot 3 (descomentar si se necesita) -->
    <!--
    <xacro:caddy_ai2_robot 
      prefix="$(arg robot3_prefix)" 
      x="$(arg robot3_x)" 
      y="$(arg robot3_y)" 
      yaw="$(arg robot3_yaw)"/>
    -->

  </world>
</sdf>