<?xml version="1.0" ?>
<sdf version="1.11" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- ============================================ -->
  <!-- Arguments (overridable from CLI or launch)   -->
  <!-- ============================================ -->
  <xacro:arg name="prefix"          default=""/>
  <xacro:arg name="namespace"       default=""/>
  <xacro:arg name="wheelbase"       default="1.65"/>
  <xacro:arg name="track_width"     default="1.0"/>
  <xacro:arg name="wheel_radius"    default="0.235"/>
  <xacro:arg name="max_steer_angle" default="0.4"/>
  <xacro:arg name="wheel_width"                default="0.22"/>
  <xacro:arg name="wheel_mass"                 default="8.7"/>
  <xacro:arg name="height"                     default="0.25"/>
  <xacro:arg name="mass"                       default="590"/>
  <xacro:arg name="vehicle_collision_width"    default="1.230"/>
  <xacro:arg name="vehicle_collision_length"   default="2.660"/>
  <xacro:arg name="vehicle_collision_height"   default="1.7"/>
  <xacro:arg name="vehicle_collision_offset_x" default="-0.25"/>
  <xacro:arg name="inertial_origin_offset_x"   default="-0.275"/>

  <!-- ============================================ -->
  <!-- Robot constants                              -->
  <!-- ============================================ -->
  <!-- Parameterizable (from robot_params.yaml via launch) -->
  <xacro:property name="wheelbase"       value="$(arg wheelbase)"/>
  <xacro:property name="track_width"     value="$(arg track_width)"/>
  <xacro:property name="wheel_radius"    value="$(arg wheel_radius)"/>
  <xacro:property name="max_steer_angle" value="$(arg max_steer_angle)"/>

  <!-- Fixed structural properties -->
  <xacro:property name="wheel_width"                value="$(arg wheel_width)"/>
  <xacro:property name="wheel_mass"                 value="$(arg wheel_mass)"/>
  <xacro:property name="height"                     value="$(arg height)"/>
  <xacro:property name="mass"                       value="$(arg mass)"/>
  <xacro:property name="PI"                         value="3.1415926535897931"/>
  <xacro:property name="vehicle_collision_width"    value="$(arg vehicle_collision_width)"/>
  <xacro:property name="vehicle_collision_length"   value="$(arg vehicle_collision_length)"/>
  <xacro:property name="vehicle_collision_height"   value="$(arg vehicle_collision_height)"/>
  <xacro:property name="vehicle_collision_offset_x" value="$(arg vehicle_collision_offset_x)"/>
  <xacro:property name="inertial_origin_offset_x"   value="$(arg inertial_origin_offset_x)"/>

  <!-- Derived geometry -->
  <xacro:property name="inertial_origin_offset_z"   value="${0.3 - wheel_radius}"/>
  <xacro:property name="vehicle_collision_offset_z" value="${vehicle_collision_height / 2 - wheel_radius}"/>

  <!-- Moments of inertia -->
  <xacro:property name="rect_Ixx"  value="${(1/12) * mass * (track_width**2 + height**2)}"/>
  <xacro:property name="rect_Iyy"  value="${(1/12) * mass * (wheelbase**2 + height**2)}"/>
  <xacro:property name="rect_Izz"  value="${(1/12) * mass * (wheelbase**2 + track_width**2)}"/>
  <xacro:property name="wheel_Ixx" value="${(1/12) * wheel_mass * (3*wheel_radius**2 + wheel_width**2)}"/>
  <xacro:property name="wheel_Iyy" value="${(1/12) * wheel_mass * (3*wheel_radius**2 + wheel_width**2)}"/>
  <xacro:property name="wheel_Izz" value="${(1/2) * wheel_mass * wheel_radius**2}"/>

  <!-- Include materials -->
  <xacro:include filename="$(find caddy_ai2_ros2_gazebo_simulation)/description/sdf/materials.sdf.xacro"/>


  <!-- ============================================ -->
  <!-- Sensors parameters                           -->
  <!-- ============================================ -->

  <!-- IMU offset from base_link -->
  <xacro:property name="imu_offset_x" value="0.7"/>
  <xacro:property name="imu_offset_y" value="0.0"/>
  <xacro:property name="imu_offset_z" value="0.4"/>
  <!-- IMU Covariance values (TODO: Characterize and update noise parameters) -->
  <xacro:property name="imu_covariance_gyro" value="0.0"/>
  <xacro:property name="imu_covariance_accel" value="0.0"/>
  <!-- IMU Update rate -->
  <xacro:property name="imu_update_rate" value="100"/>


  <!-- LIDAR offset from base_link -->
  <xacro:property name="lidar_offset_x" value="${wheelbase/2 + 0.125}"/> 
  <xacro:property name="lidar_offset_y" value="0.0"/>
  <xacro:property name="lidar_offset_z" value="0.22"/>
  <!-- LIDAR Update rate -->
  <xacro:property name="lidar_update_rate" value="75"/>
  <!-- LIDAR Noise (TODO: Characterize and update noise parameters) -->
  <xacro:property name="lidar_noise_stddev" value="0.01"/>


  <!-- GPS offset from base_link -->
  <xacro:property name="gps_offset_x" value="${-wheelbase/2}"/>
  <xacro:property name="gps_offset_y" value="0.0"/>
  <xacro:property name="gps_offset_z" value="0.5"/>
  <!-- GPS Update rate -->
  <xacro:property name="gps_update_rate" value="10"/>
  <!-- GPS Noise (TODO: Characterize and update noise parameters) -->
  <xacro:property name="gps_horiz_stddev" value="0.1"/>
  <xacro:property name="gps_vert_stddev" value="0.1"/>

  <!-- ======== END OF SENSORS PARAMETERS ========= -->


  <!-- ============================================ -->
  <!-- MACRO PRINCIPAL DEL ROBOT                    -->
  <!-- ============================================ -->
  <xacro:macro name="caddy_ai2_robot" params="prefix:='' namespace:=''">

    <model name='${prefix}caddy_ai2' canonical_link='${prefix}base_footprint'>

      <!-- ==================== ROBOT BASE ==================== -->
      <!-- Base Footprint -->
      <link name="${prefix}base_footprint">
        <pose relative_to="__model__">0 0 0 0 0 0</pose>
        <visual name="${prefix}base_footprint_visual">
          <geometry>
            <box>
              <size>${vehicle_collision_length} ${vehicle_collision_width} 0.01</size>
            </box>
          </geometry>
          <xacro:material_color rgba="${color_red}"/>
        </visual>
      </link>

      <joint name="${prefix}base_joint" type="fixed">
        <parent>${prefix}base_footprint</parent>
        <child>${prefix}base_link</child>
      </joint>

      <!-- Base Link -->
      <link name='${prefix}base_link'>
        <pose relative_to="${prefix}base_footprint">0 0 ${wheel_radius} 0 0 0</pose>
        <inertial>
          <mass>${mass}</mass>
          <pose>${inertial_origin_offset_x} 0 ${inertial_origin_offset_z} 0 0 0</pose>
          <inertia>
            <ixx>${rect_Ixx}</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>${rect_Iyy}</iyy><iyz>0</iyz><izz>${rect_Izz}</izz>
          </inertia>
        </inertial>
        <visual name="${prefix}base_link_visual">
          <geometry>
            <mesh>
              <uri>package://caddy_ai2_ros2_gazebo_simulation/description/meshes/stl/rbcar_chassis.stl</uri>
            </mesh>
          </geometry>
          <xacro:material_color rgba="${color_white}"/>
        </visual>
        <collision name="${prefix}base_link_collision">
          <pose>${vehicle_collision_offset_x} 0 ${vehicle_collision_offset_z} 0 0 0 </pose>
          <geometry>
            <box>
              <size>${vehicle_collision_length} ${vehicle_collision_width} ${vehicle_collision_height}</size>
            </box>
          </geometry>
        </collision>
        <sensor name="${prefix}navsat_sensor" type="navsat">
          <always_on>1</always_on>
          <update_rate>10</update_rate>
          <pose>0 0 0 0 0 0</pose>
          <xacro:if value="${namespace != ''}">
            <topic>/${namespace}/navsat</topic>
          </xacro:if>
          <xacro:unless value="${namespace != ''}">
            <topic>/navsat</topic>
          </xacro:unless>
        </sensor>
      </link>

      <!-- ==================== MACROS PARA RUEDAS ==================== -->

      <!-- Ruedas traseras: control de VELOCIDAD -->
      <xacro:macro name="rear_wheel" params="name y_offset">
        <link name="${prefix}${name}">
          <pose relative_to="${prefix}base_link">-${wheelbase/2} ${y_offset} 0 0 0 ${PI/2}</pose>
          <collision name="${prefix}${name}_collision">
            <pose>0 0 0 ${PI/2} 0 ${PI/2}</pose>
            <geometry>
              <cylinder>
                <length>${wheel_width}</length>
                <radius>${wheel_radius}</radius>
              </cylinder>
            </geometry>
          </collision>
          <visual name="${prefix}${name}_visual">
            <pose>0 0 0 ${PI/2} 0 ${PI/2}</pose>
            <geometry>
              <cylinder>
                <length>${wheel_width}</length>
                <radius>${wheel_radius}</radius>
              </cylinder>
            </geometry>
            <xacro:material_color rgba="${color_black}"/>
          </visual>
          <inertial>
            <pose>0 0 0 ${PI/2} 0 ${PI/2}</pose>
            <mass>${wheel_mass}</mass>
            <inertia>
              <ixx>${wheel_Ixx}</ixx><ixy>0</ixy><ixz>0</ixz>
              <iyy>${wheel_Iyy}</iyy><iyz>0</iyz><izz>${wheel_Izz}</izz>
            </inertia>
          </inertial>
        </link>

        <joint name="${prefix}${name}_joint" type="revolute">
          <parent>${prefix}base_link</parent>
          <child>${prefix}${name}</child>
          <pose relative_to='${prefix}${name}'/>
          <axis>
            <xyz expressed_in='__model__'>0 1 0</xyz>
            <limit><lower>-1e308</lower><upper>1e308</upper></limit>
            <dynamics damping="0.01" friction="0.01"/>
          </axis>

          <!-- === gz_ros2_control: VELOCITY para tracción === -->
          <gz_ros2_control>
            <command_interface name="velocity">
              <param name="min">-10</param>
              <param name="max">10</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
          </gz_ros2_control>

        </joint>
      </xacro:macro>

      <!-- Ruedas delanteras: steering con control de POSICIÓN + wheel pasivo -->
      <xacro:macro name="front_wheel_assembly" params="name y_offset">

        <!-- Steering joint: control de POSICIÓN -->
        <link name="${prefix}${name}_steer_link">
          <pose relative_to="${prefix}base_link">${wheelbase/2} ${y_offset} 0 0 0 0</pose>
        </link>

        <joint name="${prefix}${name}_steer_joint" type="revolute">
          <parent>${prefix}base_link</parent>
          <child>${prefix}${name}_steer_link</child>
          <pose relative_to='${prefix}${name}_steer_link'/>
          <axis>
            <xyz expressed_in='__model__'>0 0 1</xyz>
            <limit><lower>${-max_steer_angle}</lower><upper>${max_steer_angle}</upper><effort>1e6</effort><velocity>100</velocity></limit>
            <dynamics damping="1.0" friction="0.1"/>
          </axis>

          <!-- === gz_ros2_control: POSITION para dirección === -->
          <gz_ros2_control>
            <command_interface name="position">
              <param name="min">-${max_steer_angle}</param>
              <param name="max">${max_steer_angle}</param>
            </command_interface>
            <state_interface name="position"/>
          </gz_ros2_control>

        </joint>

        <!-- Wheel joint: solo estado (sigue pasivamente al steering) -->
        <link name="${prefix}${name}">
          <pose relative_to="${prefix}${name}_steer_link">0 0 0 -${PI/2} 0 0</pose>
          <collision name="${prefix}${name}_collision">
            <geometry>
              <cylinder>
                <length>${wheel_width}</length>
                <radius>${wheel_radius}</radius>
              </cylinder>
            </geometry>
          </collision>
          <visual name="${prefix}${name}_visual">
            <geometry>
              <cylinder>
                <length>${wheel_width}</length>
                <radius>${wheel_radius}</radius>
              </cylinder>
            </geometry>
            <xacro:material_color rgba="${color_black}"/>
          </visual>
          <inertial>
            <mass>${wheel_mass}</mass>
            <inertia>
              <ixx>${wheel_Ixx}</ixx><ixy>0</ixy><ixz>0</ixz>
              <iyy>${wheel_Iyy}</iyy><iyz>0</iyz><izz>${wheel_Izz}</izz>
            </inertia>
          </inertial>
        </link>

        <joint name="${prefix}${name}_joint" type="revolute">
          <parent>${prefix}${name}_steer_link</parent>
          <child>${prefix}${name}</child>
          <pose relative_to="${prefix}${name}"/>
          <axis>
            <xyz expressed_in='__model__'>0 1 0</xyz>
            <limit><lower>-1e308</lower><upper>1e308</upper></limit>
          </axis>

          <!-- === Solo state interfaces para rueda delantera === -->
          <gz_ros2_control>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </gz_ros2_control>

        </joint>
      </xacro:macro>

      <!-- ==================== INSTANCIAR RUEDAS ==================== -->
      <xacro:rear_wheel name="rear_right_wheel" y_offset="-${track_width/2}"/>
      <xacro:rear_wheel name="rear_left_wheel" y_offset="${track_width/2}"/>
      <xacro:front_wheel_assembly name="front_right_wheel" y_offset="-${track_width/2}"/>
      <xacro:front_wheel_assembly name="front_left_wheel" y_offset="${track_width/2}"/>

      <!-- ==================== gz_ros2_control ==================== -->

      <!-- Hardware interfaces para ros2_control.
           sdformat_urdf copia este bloque al URDF resultante, donde el
           controller_manager lo encuentra al recibir robot_description. -->
      <ros2_control name="${prefix}caddy_ai2_hardware" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <!-- Ruedas traseras: velocidad -->
        <joint name="${prefix}rear_right_wheel_joint">
          <command_interface name="velocity">
            <param name="min">-10</param>
            <param name="max">10</param>
          </command_interface>
          <state_interface name="velocity"/>
          <state_interface name="position"/>
        </joint>
        <joint name="${prefix}rear_left_wheel_joint">
          <command_interface name="velocity">
            <param name="min">-10</param>
            <param name="max">10</param>
          </command_interface>
          <state_interface name="velocity"/>
          <state_interface name="position"/>
        </joint>

        <!-- Steering delantero: posición -->
        <joint name="${prefix}front_right_wheel_steer_joint">
          <command_interface name="position">
            <param name="min">-${max_steer_angle}</param>
            <param name="max">${max_steer_angle}</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>
        <joint name="${prefix}front_left_wheel_steer_joint">
          <command_interface name="position">
            <param name="min">-${max_steer_angle}</param>
            <param name="max">${max_steer_angle}</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>

        <!-- Ruedas delanteras: solo estado (pasivas) -->
        <joint name="${prefix}front_right_wheel_joint">
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}front_left_wheel_joint">
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>

      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <ros>
          <xacro:if value="${namespace != ''}">
            <namespace>/${namespace}</namespace>
          </xacro:if>
          <remapping>bicycle_steering_controller/tf_odometry:=/tf</remapping>
        </ros>
        <parameters>$(find caddy_ai2_ros2_gazebo_simulation)/bringup/config/controllers_simulation.yaml</parameters>
      </plugin>



      <!-- ================================================================================================= -->
      <!-- =                      SENSORS CONFIGURATION SECTION: IMU, LIDAR & GPS                          = -->
      <!-- ================================================================================================= -->

      <!-- Definimos enlace y unión para la IMU: -->
      <!-- IMU Link -->
      <link name="${prefix}imu_link">
        <pose relative_to="${prefix}base_link">${imu_offset_x} ${imu_offset_y} ${imu_offset_z} 0 0 0</pose>
        <visual name="${prefix}imu_visual">
          <geometry>
            <box>
              <size>0.05 0.05 0.02</size>
            </box>
          </geometry>
          <xacro:material_color rgba="${color_black}"/>
        </visual>

        <sensor name="${prefix}imu_sensor" type="imu">
          <always_on>true</always_on>
          <!-- IMU Sampling (and publishing) rate -->
          <update_rate>${imu_update_rate}</update_rate>
          <visualize>true</visualize>
          
          <xacro:if value="${namespace != ''}">
            <topic>/${namespace}/imu</topic>
          </xacro:if>
          <xacro:unless value="${namespace != ''}">
            <topic>/imu</topic>
          </xacro:unless>
          
          <gz_frame_id>${prefix}imu_link</gz_frame_id>
          
          <imu>
            <angular_velocity>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_covariance_gyro}</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_covariance_gyro}</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_covariance_gyro}</stddev></noise></z>
            </angular_velocity>
            <linear_acceleration>
              <x><noise type="gaussian"><mean>0.0</mean><stddev>${imu_covariance_accel}</stddev></noise></x>
              <y><noise type="gaussian"><mean>0.0</mean><stddev>${imu_covariance_accel}</stddev></noise></y>
              <z><noise type="gaussian"><mean>0.0</mean><stddev>${imu_covariance_accel}</stddev></noise></z>
            </linear_acceleration>
          </imu>
        </sensor>

      </link>
      <!-- IMU Joint -->
      <joint name="${prefix}imu_joint" type="fixed">
        <parent>${prefix}base_link</parent>
        <child>${prefix}imu_link</child>
      </joint>

      <!-- Definimos enlace y unión para el LIDAR: -->
      <!-- LIDAR Link -->
      <link name="${prefix}lidar_link">

        <pose relative_to="${prefix}base_link">${lidar_offset_x} ${lidar_offset_y} ${lidar_offset_z} 0 0 0</pose>
        
        <visual name="${prefix}lidar_visual">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.15</length>
            </cylinder>
          </geometry>
          <xacro:material_color rgba="${color_blue}"/>
        </visual>
        
        <collision name="${prefix}lidar_collision">
          <geometry>
            <cylinder>
              <radius>0.08</radius>
              <length>0.15</length>
            </cylinder>
          </geometry>
        </collision>

        <sensor name="${prefix}lidar_sensor" type="gpu_lidar">
          <always_on>true</always_on>
          <update_rate>${lidar_update_rate}</update_rate> 
          <visualize>true</visualize> 

          <xacro:if value="${namespace != ''}">
            <topic>/${namespace}/scan</topic>
          </xacro:if>
          <xacro:unless value="${namespace != ''}">
            <topic>/scan</topic>
          </xacro:unless>

          <gz_frame_id>${prefix}lidar_link</gz_frame_id>
          
          <lidar>
            <scan>
              <horizontal>
                <samples>181</samples>
                <resolution>1</resolution>
                <min_angle>-1.570796</min_angle>
                <max_angle>1.570796</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.10</min> <max>80.0</max> <resolution>0.01</resolution> </range>
            <noise>
              <type>gaussian</type>
              <mean>0.0</mean>
              <stddev>${lidar_noise_stddev}</stddev> </noise>
          </lidar>
        </sensor>

      </link>
      <!-- LIDAR Joint -->
      <joint name="${prefix}lidar_joint" type="fixed">
        <parent>${prefix}base_link</parent>
        <child>${prefix}lidar_link</child>
      </joint>

      <!-- Definimos enlace y unión para el GPS (TODO: Merge con rama GPS) --> 

      <!-- ================================================================================================= -->
      <!-- ============================== END OF SENSORS PLACEMENT SECTION ================================= -->
      <!-- ================================================================================================= -->


    </model>
  </xacro:macro>


  <!-- ============================================ -->
  <!-- Auto-instantiate for standalone use          -->
  <!-- ============================================ -->
  <xacro:caddy_ai2_robot
    prefix="$(arg prefix)"
    namespace="$(arg namespace)"/>

</sdf>
