<?xml version="1.0" ?>
<sdf version="1.11" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Include materials -->
  <xacro:include filename="$(find caddy_ai2_ros2_gazebo_simulation)/description/sdf/materials.sdf.xacro"/>

  <!-- ============================================ -->
  <!-- MACRO PRINCIPAL DEL ROBOT                    -->
  <!-- ============================================ -->
  <xacro:macro name="caddy_ai2_robot" params="prefix:='' namespace:=''">

    <model name='${prefix}caddy_ai2' canonical_link='${prefix}base_link'>
      
      <!-- === CONSTANTES DEL ROBOT === -->
      <xacro:property name="wheel_radius" value="0.235"/>
      <xacro:property name="wheel_width" value="0.22"/>
      <xacro:property name="wheel_mass" value="8.7"/>
      <xacro:property name="track_width" value="1"/>
      <xacro:property name="wheelbase" value="1.65"/>
      <xacro:property name="height" value="0.25"/>
      <xacro:property name="mass" value="590"/>
      <xacro:property name="inertial_origin_offset_x" value="-0.275"/>
      <xacro:property name="inertial_origin_offset_z" value="${0.3-wheel_radius}"/>
      <xacro:property name="max_steer_angle" value="0.5"/>
      <xacro:property name="vehicle_collision_width" value="1.230"/>
      <xacro:property name="vehicle_collision_length" value="2.660"/>
      <xacro:property name="vehicle_collision_height" value="1.7"/>
      <xacro:property name="vehicle_collision_offset_x" value="-0.25"/>
      <xacro:property name="vehicle_collision_offset_z" value="${1.7/2 - wheel_radius}"/>
      <xacro:property name="PI" value="3.1415926535897931"/>

      <!-- Moments of inertia -->
      <xacro:property name="rect_Ixx" value="${(1/12) * mass * (track_width**2 + height**2)}"/>
      <xacro:property name="rect_Iyy" value="${(1/12) * mass * (wheelbase**2 + height**2)}"/>
      <xacro:property name="rect_Izz" value="${(1/12) * mass * (wheelbase**2 + track_width**2)}"/>
      <xacro:property name="wheel_Ixx" value="${(1/12) * wheel_mass * (3*wheel_radius**2 + wheel_width**2)}"/>
      <xacro:property name="wheel_Iyy" value="${(1/12) * wheel_mass * (3*wheel_radius**2 + wheel_width**2)}"/>
      <xacro:property name="wheel_Izz" value="${(1/2) * wheel_mass * wheel_radius**2}"/>

      <!-- ==================== ROBOT BASE ==================== -->
      <link name='${prefix}base_link'>
        <must_be_base_link>true</must_be_base_link>
        <inertial>
          <mass>${mass}</mass>
          <pose>${inertial_origin_offset_x} 0 ${inertial_origin_offset_z} 0 0 0</pose>
          <inertia>
            <ixx>${rect_Ixx}</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>${rect_Iyy}</iyy><iyz>0</iyz><izz>${rect_Izz}</izz>
          </inertia>
        </inertial>
        <visual name="${prefix}base_link_visual">
          <geometry>
            <mesh>
              <uri>package://caddy_ai2_ros2_gazebo_simulation/description/meshes/stl/rbcar_chassis.stl</uri>
            </mesh>
          </geometry>
          <xacro:material_color rgba="${color_white}"/>
        </visual>
        <collision name="${prefix}base_link_collision">
          <pose>${vehicle_collision_offset_x} 0 ${vehicle_collision_offset_z} 0 0 0 </pose>
          <geometry>
            <box>
              <size>${vehicle_collision_length} ${vehicle_collision_width} ${vehicle_collision_height}</size>
            </box>
          </geometry>
        </collision>
      </link>

      <!-- Base Footprint -->
      <link name="${prefix}base_footprint">
        <pose relative_to="${prefix}base_link">${vehicle_collision_offset_x} 0.0 -${wheel_radius-0.01} 0 0 0</pose>
        <visual name="${prefix}base_footprint_visual">
          <geometry>
            <box>
              <size>${vehicle_collision_length} ${vehicle_collision_width} 0.01</size>
            </box>
          </geometry>
          <xacro:material_color rgba="${color_red}"/>
        </visual>
      </link>

      <joint name="${prefix}base_joint" type="fixed">
        <parent>${prefix}base_link</parent>
        <child>${prefix}base_footprint</child>
        <pose relative_to='${prefix}base_footprint'/>
      </joint>

      <!-- ==================== MACROS PARA RUEDAS ==================== -->
      
      <!-- Ruedas traseras: control de VELOCIDAD -->
      <xacro:macro name="rear_wheel" params="name y_offset">
        <link name="${prefix}${name}">
          <pose relative_to="${prefix}base_link">-${wheelbase/2} ${y_offset} 0 0 0 ${PI/2}</pose>
          <collision name="${prefix}${name}_collision">
            <pose>0 0 0 ${PI/2} 0 ${PI/2}</pose>
            <geometry>
              <cylinder>
                <length>${wheel_width}</length>
                <radius>${wheel_radius}</radius>
              </cylinder>
            </geometry>
          </collision>
          <visual name="${prefix}${name}_visual">
            <pose>0 0 0 ${PI/2} 0 ${PI/2}</pose>
            <geometry>
              <cylinder>
                <length>${wheel_width}</length>
                <radius>${wheel_radius}</radius>
              </cylinder>
            </geometry>
            <xacro:material_color rgba="${color_black}"/>
          </visual>
          <inertial>
            <pose>0 0 0 ${PI/2} 0 ${PI/2}</pose>
            <mass>${wheel_mass}</mass>
            <inertia>
              <ixx>${wheel_Ixx}</ixx><ixy>0</ixy><ixz>0</ixz>
              <iyy>${wheel_Iyy}</iyy><iyz>0</iyz><izz>${wheel_Izz}</izz>
            </inertia>
          </inertial>
        </link>
        
        <joint name="${prefix}${name}_joint" type="revolute">
          <parent>${prefix}base_link</parent>
          <child>${prefix}${name}</child>
          <pose relative_to='${prefix}${name}'/>
          <axis>
            <xyz expressed_in='__model__'>0 1 0</xyz>
            <limit><lower>-1e308</lower><upper>1e308</upper></limit>
            <dynamics damping="0.01" friction="0.01"/>
          </axis>
          
          <!-- === gz_ros2_control: VELOCITY para tracción === -->
          <gz_ros2_control>
            <command_interface name="velocity">
              <param name="min">-10</param>
              <param name="max">10</param>
            </command_interface>
            <state_interface name="velocity"/>
            <state_interface name="position"/>
          </gz_ros2_control>
          
        </joint>
      </xacro:macro>

      <!-- Ruedas delanteras: steering con control de POSICIÓN + wheel pasivo -->
      <xacro:macro name="front_wheel_assembly" params="name y_offset">
        
        <!-- Steering joint: control de POSICIÓN -->
        <link name="${prefix}${name}_steer_link">
          <pose relative_to="${prefix}base_link">${wheelbase/2} ${y_offset} 0 0 0 0</pose>
        </link>
        
        <joint name="${prefix}${name}_steer_joint" type="revolute">
          <parent>${prefix}base_link</parent>
          <child>${prefix}${name}_steer_link</child>
          <pose relative_to='${prefix}${name}_steer_link'/>
          <axis>
            <xyz expressed_in='__model__'>0 0 1</xyz>
            <limit><lower>${-max_steer_angle}</lower><upper>${max_steer_angle}</upper><effort>1e6</effort><velocity>100</velocity></limit>
            <dynamics damping="1.0" friction="0.1"/>
          </axis>
          
          <!-- === gz_ros2_control: POSITION para dirección === -->
          <gz_ros2_control>
            <command_interface name="position">
              <param name="min">-${max_steer_angle}</param>
              <param name="max">${max_steer_angle}</param>
            </command_interface>
            <state_interface name="position"/>
          </gz_ros2_control>
          
        </joint>
        
        <!-- Wheel joint: solo estado (sigue pasivamente al steering) -->
        <link name="${prefix}${name}">
          <pose relative_to="${prefix}${name}_steer_link">0 0 0 -${PI/2} 0 0</pose>
          <collision name="${prefix}${name}_collision">
            <geometry>
              <cylinder>
                <length>${wheel_width}</length>
                <radius>${wheel_radius}</radius>
              </cylinder>
            </geometry>
          </collision>
          <visual name="${prefix}${name}_visual">
            <geometry>
              <cylinder>
                <length>${wheel_width}</length>
                <radius>${wheel_radius}</radius>
              </cylinder>
            </geometry>
            <xacro:material_color rgba="${color_black}"/>
          </visual>
          <inertial>
            <mass>${wheel_mass}</mass>
            <inertia>
              <ixx>${wheel_Ixx}</ixx><ixy>0</ixy><ixz>0</ixz>
              <iyy>${wheel_Iyy}</iyy><iyz>0</iyz><izz>${wheel_Izz}</izz>
            </inertia>
          </inertial>
        </link>
        
        <joint name="${prefix}${name}_joint" type="revolute">
          <parent>${prefix}${name}_steer_link</parent>
          <child>${prefix}${name}</child>
          <pose relative_to="${prefix}${name}"/>
          <axis>
            <xyz expressed_in='__model__'>0 1 0</xyz>
            <limit><lower>-1e308</lower><upper>1e308</upper></limit>
          </axis>
          
          <!-- === Solo state interfaces para rueda delantera === -->
          <gz_ros2_control>
            <state_interface name="position"/>
            <state_interface name="velocity"/>
          </gz_ros2_control>
          
        </joint>
      </xacro:macro>

      <!-- ==================== INSTANCIAR RUEDAS ==================== -->
      <xacro:rear_wheel name="rear_right_wheel" y_offset="-${track_width/2}"/>
      <xacro:rear_wheel name="rear_left_wheel" y_offset="${track_width/2}"/>
      <xacro:front_wheel_assembly name="front_right_wheel" y_offset="-${track_width/2}"/>
      <xacro:front_wheel_assembly name="front_left_wheel" y_offset="${track_width/2}"/>

      <!-- ==================== gz_ros2_control ==================== -->

      <!-- Hardware interfaces para ros2_control.
           sdformat_urdf copia este bloque al URDF resultante, donde el
           controller_manager lo encuentra al recibir robot_description. -->
      <ros2_control name="${prefix}caddy_ai2_hardware" type="system">
        <hardware>
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <!-- Ruedas traseras: velocidad -->
        <joint name="${prefix}rear_right_wheel_joint">
          <command_interface name="velocity">
            <param name="min">-10</param>
            <param name="max">10</param>
          </command_interface>
          <state_interface name="velocity"/>
          <state_interface name="position"/>
        </joint>
        <joint name="${prefix}rear_left_wheel_joint">
          <command_interface name="velocity">
            <param name="min">-10</param>
            <param name="max">10</param>
          </command_interface>
          <state_interface name="velocity"/>
          <state_interface name="position"/>
        </joint>

        <!-- Steering delantero: posición -->
        <joint name="${prefix}front_right_wheel_steer_joint">
          <command_interface name="position">
            <param name="min">-${max_steer_angle}</param>
            <param name="max">${max_steer_angle}</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>
        <joint name="${prefix}front_left_wheel_steer_joint">
          <command_interface name="position">
            <param name="min">-${max_steer_angle}</param>
            <param name="max">${max_steer_angle}</param>
          </command_interface>
          <state_interface name="position"/>
        </joint>

        <!-- Ruedas delanteras: solo estado (pasivas) -->
        <joint name="${prefix}front_right_wheel_joint">
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="${prefix}front_left_wheel_joint">
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>

      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <xacro:if value="${namespace != ''}">
          <ros>
            <namespace>/${namespace}</namespace>
          </ros>
        </xacro:if>
        <parameters>$(find caddy_ai2_ros2_gazebo_simulation)/bringup/config/controllers_simulation.yaml</parameters>
      </plugin>

    </model>
  </xacro:macro>
</sdf>