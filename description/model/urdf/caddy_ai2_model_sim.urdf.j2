{%- extends 'caddy_ai2_model.urdf.j2' %}
{%- block extension %}

  <!-- ==================== ROS2 CONTROL ==================== -->
  <ros2_control name="{{ prefix }}caddy_ai2_hardware" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

    <joint name="{{ prefix }}rear_right_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>
    <joint name="{{ prefix }}rear_left_wheel_joint">
      <command_interface name="velocity">
        <param name="min">-10</param>
        <param name="max">10</param>
      </command_interface>
      <state_interface name="velocity"/>
      <state_interface name="position"/>
    </joint>

    <joint name="{{ prefix }}front_right_wheel_steer_joint">
      <command_interface name="position">
        <param name="min">{{ -max_steer_angle }}</param>
        <param name="max">{{ max_steer_angle }}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="{{ prefix }}front_left_wheel_steer_joint">
      <command_interface name="position">
        <param name="min">{{ -max_steer_angle }}</param>
        <param name="max">{{ max_steer_angle }}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="{{ prefix }}front_right_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="{{ prefix }}front_left_wheel_joint">
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ==================== AXLE CENTER LINKS: preserve in Gazebo ==================== -->
  <gazebo reference="{{ prefix }}front_axle_center_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="{{ prefix }}rear_axle_center_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

{%- set ns_prefix = ('/' + namespace + '/') if namespace else '/' %}

  <!-- ==================== GROUND TRUTH ODOMETRY ==================== -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>world</odom_frame>
      <robot_base_frame>{{ prefix }}base_footprint</robot_base_frame>
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>{{ ns_prefix }}ground_truth/odometry</odom_topic>
      <tf_topic>{{ ns_prefix }}ground_truth/tf</tf_topic>
    </plugin>
  </gazebo>

  <!-- ==================== NAVSAT / GPS (ground truth — no noise) ==================== -->
  <gazebo reference="{{ prefix }}base_footprint">
    <sensor name="{{ prefix }}navsat_base" type="navsat">
      <topic>{{ ns_prefix }}navsat/base/fix</topic>
      <update_rate>5</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <gazebo reference="{{ prefix }}front_axle_center_link">
    <sensor name="{{ prefix }}navsat_front_axle" type="navsat">
      <topic>{{ ns_prefix }}navsat/front_axle/fix</topic>
      <update_rate>5</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <gazebo reference="{{ prefix }}rear_axle_center_link">
    <sensor name="{{ prefix }}navsat_rear_axle" type="navsat">
      <topic>{{ ns_prefix }}navsat/rear_axle/fix</topic>
      <update_rate>5</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- ==================== GAZEBO PLUGIN ==================== -->
  <gazebo>
    <plugin filename="gz_ros2_control-system"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <ros>
        {%- if namespace %}
        <namespace>/{{ namespace }}</namespace>
        {%- endif %}
        <remapping>bicycle_steering_controller/tf_odometry:=/tf</remapping>
      </ros>
      <parameters>{{ controllers_yaml_path }}</parameters>
    </plugin>
  </gazebo>
{%- endblock %}
