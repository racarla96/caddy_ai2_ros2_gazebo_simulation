<?xml version="1.0" ?>
<sdf version="1.11">

  <!-- SDF Specification 1.11 -->
  <!-- https://sdformat.org/spec/1.11/sdf/ -->

  <!-- Rectangular enclosure (20 m x 20 m) with 3 internal obstacles for SLAM/Nav2 testing.
       Corridors are ≥5 m wide — compatible with the Caddy AI2 minimum turning radius (~2 m).
       Layout (top view, robot spawns at origin):

           -10          0          +10   (X)
       +10  +----+----+-----+------+
            |    |         |      |
        +5  |    |   OBS1  |      |
            |    +---------+      |
            |                     |
            |                     |
            |    +---------+      |
        -5  |    |   OBS2  |      |
            |    |         |      |
       -10  +----+---------+------+
  -->

  <world name='navigation_test'>

    <!-- Physics and required plugins -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Global config -->
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- GPS coordinates (same as caddy_ai2_world for consistency) -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>40.4168</latitude_deg>
      <longitude_deg>-3.7038</longitude_deg>
      <elevation>600.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Camera: isometric view of the full arena -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 -28 22 0 0.72 1.5708</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- ================================================================ -->
    <!-- PERIMETER WALLS (20 m x 20 m enclosure, 0.3 m thick, 1.5 m tall) -->
    <!-- ================================================================ -->

    <!-- North wall (y = +10) -->
    <model name='wall_north'>
      <static>1</static>
      <pose>0 10 0.75 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>20.6 0.3 1.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>20.6 0.3 1.5</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- South wall (y = -10) -->
    <model name='wall_south'>
      <static>1</static>
      <pose>0 -10 0.75 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>20.6 0.3 1.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>20.6 0.3 1.5</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- East wall (x = +10) -->
    <model name='wall_east'>
      <static>1</static>
      <pose>10 0 0.75 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.3 20 1.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.3 20 1.5</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- West wall (x = -10) -->
    <model name='wall_west'>
      <static>1</static>
      <pose>-10 0 0.75 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>0.3 20 1.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>0.3 20 1.5</size></box></geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- INTERNAL OBSTACLES                                                -->
    <!--                                                                   -->
    <!-- obstacle_1: north partial wall (x: -7 to +1, y = +4)            -->
    <!--   leaves a 9 m passage on the east side — wide enough for U-turn -->
    <!--                                                                   -->
    <!-- obstacle_2: south partial wall (x: -1 to +7, y = -4)            -->
    <!--   leaves a 9 m passage on the west side — creates snake corridor  -->
    <!--                                                                   -->
    <!-- obstacle_3: isolated column in the NE quadrant (landmark for SLAM)-->
    <!-- ================================================================ -->

    <!-- Obstacle 1: horizontal box blocking northern passage from west -->
    <model name='obstacle_1'>
      <static>1</static>
      <pose>-3 4 0.75 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>8 0.5 1.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>8 0.5 1.5</size></box></geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 2: horizontal box blocking southern passage from east -->
    <model name='obstacle_2'>
      <static>1</static>
      <pose>3 -4 0.75 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><box><size>8 0.5 1.5</size></box></geometry>
        </collision>
        <visual name='visual'>
          <geometry><box><size>8 0.5 1.5</size></box></geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Obstacle 3: isolated column — unique SLAM landmark in NE quadrant -->
    <model name='obstacle_3'>
      <static>1</static>
      <pose>7 6 0.75 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry><cylinder><radius>0.5</radius><length>1.5</length></cylinder></geometry>
        </collision>
        <visual name='visual'>
          <geometry><cylinder><radius>0.5</radius><length>1.5</length></cylinder></geometry>
          <material>
            <ambient>0.8 0.3 0.1 1</ambient>
            <diffuse>0.8 0.3 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
