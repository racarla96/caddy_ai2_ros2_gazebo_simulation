<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="simulation_caddy_ai2">

  <!-- ==================== PARAMS WITH DEFAULT VALUES ==================== -->
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="is_simulation" default="true" />

  <!-- Import Caddy AI2 description of the vehicle macro -->
  <xacro:include filename="$(find caddy_ai2_ros2_gazebo_simulation)/description/urdf/caddy_ai2.urdf.xacro" />

  <xacro:caddy_ai2 prefix="$(arg prefix)" is_simulation="$(arg is_simulation)">
    <origin xyz="0 0 0.235" rpy="0 0 0" />
  </xacro:caddy_ai2>

</robot>